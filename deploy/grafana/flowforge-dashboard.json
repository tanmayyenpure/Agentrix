{
  "title": "FlowForge Overview",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "Backend Up",
      "targets": [{ "expr": "up{job=\"flowforge-backend\"}" }],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count[5m]))" }],
      "gridPos": { "x": 6, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "5xx Errors",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))" }],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }
    }
  ]
}
